      <contenuAuteur>            
         <dispositif>&lt;p style="text-align: justify;"&gt;I.&amp;nbsp;&amp;#x2013;&amp;nbsp;&amp;#x00C0;&amp;nbsp;la premi&amp;#x00E8;re phrase de l&amp;#x2019;alin&amp;#x00E9;a&amp;nbsp;6, supprimer les mots&amp;nbsp;:&lt;/p&gt;&lt;p style="text-align: justify;"&gt;&amp;#x00AB;&amp;nbsp;en principe&amp;nbsp;&amp;#x00BB;.&lt;/p&gt;&lt;p style="text-align: justify;"&gt;II.&amp;nbsp;&amp;#x2013;&amp;nbsp;En cons&amp;#x00E9;quence, supprimer la seconde phrase du m&amp;#x00EA;me alin&amp;#x00E9;a.&lt;/p&gt;</dispositif>            
         <avantAppel xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:nil="true"/>            
         <exposeSommaire>&lt;p&gt;Pour assurer une &amp;#x00E9;galit&amp;#x00E9; de traitement entre tous les &amp;#x00E9;leveurs, la loi doit autoriser le recours aux tirs de d&amp;#x00E9;fense sans distinction g&amp;#x00E9;ographique. &amp;#x00C0; cette fin, l&amp;#x2019;&amp;#x00E9;valuation de l&amp;#x2019;&amp;#x00E9;tat de conservation du loup est men&amp;#x00E9;e &amp;#x00E0; l&amp;#x2019;&amp;#x00E9;chelle nationale, garantissant ainsi une approche uniforme et &amp;#x00E9;quitable sur l&amp;#x2019;ensemble du territoire.&lt;/p&gt;&lt;p&gt;Cet amendement a &amp;#x00E9;t&amp;#x00E9; travaill&amp;#x00E9; avec la FNSEA.&amp;nbsp;&lt;/p&gt;</exposeSommaire>            
         <annexeExposeSommaire xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:nil="true"/>        
      </contenuAuteur>    
