      <contenuAuteur>            
         <dispositif>&lt;p style="text-align: justify;"&gt;Apr&amp;#x00E8;s l&amp;#x2019;alin&amp;#x00E9;a&amp;nbsp;4, ins&amp;#x00E9;rer l&amp;#x2019;alin&amp;#x00E9;a suivant&amp;nbsp;:&amp;nbsp;&lt;/p&gt;&lt;p style="text-align: justify;"&gt;&amp;#x00AB;&amp;nbsp;Les attaques et dommages caus&amp;#x00E9;s par le loup sont constat&amp;#x00E9;s sur place par un agent habilit&amp;#x00E9; ou par voie &amp;#x00E9;lectronique. L&amp;#x2019;arr&amp;#x00EA;t&amp;#x00E9; pr&amp;#x00E9;cise les conditions dans lesquelles le constat peut &amp;#x00EA;tre r&amp;#x00E9;alis&amp;#x00E9; par l&amp;#x2019;&amp;#x00E9;leveur.&amp;nbsp;&amp;#x00BB;&lt;/p&gt;</dispositif>            
         <avantAppel xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:nil="true"/>            
         <exposeSommaire>&lt;p style="text-align: justify;"&gt;Cet amendement pr&amp;#x00E9;voit que le constat de dommages dus &amp;#x00E0; la pr&amp;#x00E9;dation du loup puisse &amp;#x00EA;tre r&amp;#x00E9;alis&amp;#x00E9; de mani&amp;#x00E8;re &amp;#x00E9;lectronique. L&amp;#x2019;objectif est de permettre de r&amp;#x00E9;aliser les constats plus rapidement. Cette am&amp;#x00E9;lioration a pour effet de faciliter les d&amp;#x00E9;marches d&amp;#x2019;indemnisation.&amp;nbsp;&lt;/p&gt;</exposeSommaire>            
         <annexeExposeSommaire xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:nil="true"/>        
      </contenuAuteur>    
