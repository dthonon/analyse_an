   <corps>        
      <cartoucheInformatif>Sous réserve de son traitement par les services de l'Assemblée nationale et de sa recevabilité</cartoucheInformatif>        
      <contenuAuteur>            
         <dispositif>&lt;p style="text-align: justify;"&gt;I.&amp;nbsp;&amp;#x2013;&amp;nbsp;&amp;#x00C0; la derni&amp;#x00E8;re phrase de l&amp;#x2019;alin&amp;#x00E9;a&amp;nbsp;5, supprimer les mots&amp;nbsp;:&lt;/p&gt;&lt;p style="text-align: justify;"&gt;&amp;#x00AB;&amp;nbsp;,&amp;nbsp;compte tenu de l&amp;#x2019;absence de moyens de pr&amp;#x00E9;vention efficaces disponibles,&amp;nbsp;&amp;#x00BB;.&lt;/p&gt;&lt;p style="text-align: justify;"&gt;II.&amp;nbsp;&amp;#x2013;&amp;nbsp;&amp;#x00C0; la fin de la m&amp;#x00EA;me derni&amp;#x00E8;re phrase du m&amp;#x00EA;me alin&amp;#x00E9;a&amp;nbsp;5, substituer aux mots&amp;nbsp;:&lt;/p&gt;&lt;p style="text-align: justify;"&gt;&amp;#x00AB;&amp;nbsp;peuvent &amp;#x00EA;tre&amp;nbsp;&amp;#x00BB;&lt;/p&gt;&lt;p style="text-align: justify;"&gt;le mot&amp;nbsp;:&amp;nbsp;&lt;/p&gt;&lt;p style="text-align: justify;"&gt;&amp;#x00AB;&amp;nbsp;sont&amp;nbsp;&amp;#x00BB;.&lt;/p&gt;</dispositif>            
         <avantAppel xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:nil="true"/>            
         <exposeSommaire>&lt;p style="text-align: justify;"&gt;Les donn&amp;#x00E9;es scientifiques des territoires historiquement les plus concern&amp;#x00E9;s par la pr&amp;#x00E9;dation du loup d&amp;#x00E9;montrent que les mesures de protection non-l&amp;#x00E9;tales sont les plus efficaces pour prot&amp;#x00E9;ger les troupeaux.&lt;/p&gt;&lt;p style="text-align: justify;"&gt;Cet amendement vise alors &amp;#x00E0; ce que des d&amp;#x00E9;marches de protection non-l&amp;#x00E9;tales visant &amp;#x00E0; r&amp;#x00E9;duire la vuln&amp;#x00E9;rabilit&amp;#x00E9; des troupeaux &amp;#x00E9;quins et bovins soient syst&amp;#x00E9;matiquement demand&amp;#x00E9;es aux &amp;#x00E9;leveurs.&lt;/p&gt;</exposeSommaire>            
         <annexeExposeSommaire xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:nil="true"/>        
      </contenuAuteur>    
   </corps>    
