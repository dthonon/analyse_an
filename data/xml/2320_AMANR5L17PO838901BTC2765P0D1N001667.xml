   <corps>        
      <cartoucheInformatif xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:nil="true"/>        
      <contenuAuteur>            
         <dispositif>&lt;p style="text-align: justify;"&gt;I.&amp;nbsp;&amp;#x2013;&amp;nbsp;&amp;#x00C0; la fin de la deuxi&amp;#x00E8;me phrase de l&amp;#x2019;alin&amp;#x00E9;a&amp;nbsp;9, substituer aux&amp;nbsp;mots&amp;nbsp;:&amp;nbsp;&lt;/p&gt;&lt;p style="text-align: justify;"&gt;&amp;#x00AB;&amp;nbsp;peut &amp;#x00EA;tre fix&amp;#x00E9; en tenant compte du nombre minimal de sp&amp;#x00E9;cimens compatible avec un &amp;#x00E9;tat favorable de conservation.&amp;nbsp;&amp;#x00BB;&lt;/p&gt;&lt;p style="text-align: justify;"&gt;les mots&amp;nbsp;:&amp;nbsp;&lt;/p&gt;&lt;p style="text-align: justify;"&gt;&amp;#x00AB;&amp;nbsp;est fix&amp;#x00E9; de mani&amp;#x00E8;re &amp;#x00E0; ne pas nuire &amp;#x00E0; l&amp;#x2019;&amp;#x00E9;tat de conservation favorable du loup.&amp;nbsp;&amp;#x00BB;&lt;/p&gt;&lt;p style="text-align: justify;"&gt;II.&amp;nbsp;&amp;#x2013;&amp;nbsp;En cons&amp;#x00E9;quence, supprimer la derni&amp;#x00E8;re phrase du m&amp;#x00EA;me alin&amp;#x00E9;a&amp;nbsp;9.&lt;/p&gt;</dispositif>            
         <avantAppel xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:nil="true"/>            
         <exposeSommaire>&lt;p&gt;Cet amendement vise &amp;#x00E0; apporter de la coh&amp;#x00E9;rence au texte en supprimant l&amp;#x2019;alin&amp;#x00E9;a 9 qui entre en contradiction avec l&amp;#x2019;alin&amp;#x00E9;a 10. En effet, si le nombre maximal de loups pouvant &amp;#x00EA;tre d&amp;#x00E9;truits correspond &amp;#x00E0; la diff&amp;#x00E9;rence entre la population lupine estim&amp;#x00E9;e et le nombre minimal de sp&amp;#x00E9;cimens compatible avec un &amp;#x00E9;tat de conservation favorable, il ne sera plus possible une fois le plafond atteint d&amp;#x2019;autoriser l&amp;#x2019;abattage d&amp;#x2019;autres sp&amp;#x00E9;cimens sans compromettre cet &amp;#x00E9;tat de conservation favorable.&amp;nbsp;&lt;/p&gt;</exposeSommaire>            
         <annexeExposeSommaire xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:nil="true"/>        
      </contenuAuteur>    
   </corps>    
