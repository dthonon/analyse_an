      <cartoucheInformatif xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:nil="true"/>        
      <contenuAuteur>            
         <dispositif>&lt;p style="text-align: justify;"&gt;Apr&amp;#x00E8;s l&amp;#x2019;alin&amp;#x00E9;a&amp;nbsp;7, ins&amp;#x00E9;rer les deux alin&amp;#x00E9;as suivants&amp;nbsp;:&amp;nbsp;&lt;/p&gt;&lt;p style="text-align: justify;"&gt;&amp;#x00AB;&amp;nbsp;I&amp;nbsp;&lt;i&gt;bis&lt;/i&gt;.&amp;nbsp;&amp;#x2013;&amp;nbsp;Apr&amp;#x00E8;s l&amp;#x2019;article&amp;nbsp;L.&amp;nbsp;415&amp;#x2011;3 du code de l&amp;#x2019;environnement, il est ins&amp;#x00E9;r&amp;#x00E9; un article&amp;nbsp;L.&amp;nbsp;415&amp;#x2011;3&amp;#x2011;1 ainsi r&amp;#x00E9;dig&amp;#x00E9;&amp;nbsp;:&lt;/p&gt;&lt;p style="text-align: justify;"&gt;&amp;#x00AB;&amp;nbsp;&lt;i&gt;Art.&amp;nbsp;L.&amp;nbsp;415&amp;#x2011;3&amp;#x2011;1.&lt;/i&gt;&amp;nbsp;&amp;#x2013;&amp;nbsp;N&amp;#x2019;est pas p&amp;#x00E9;nalement responsable l&amp;#x2019;&amp;#x00E9;leveur qui proc&amp;#x00E8;de &amp;#x00E0; la destruction d&amp;#x2019;un loup dans le but de d&amp;#x00E9;fendre son troupeau contre une attaque, d&amp;#x00E8;s lors que son action est n&amp;#x00E9;cessaire et proportionn&amp;#x00E9;e.&amp;nbsp;&amp;#x00BB;&amp;nbsp;&amp;#x00BB;&lt;/p&gt;</dispositif>            
         <avantAppel xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:nil="true"/>            
         <exposeSommaire>&lt;p style="text-align: justify;"&gt;Les &amp;#x00E9;leveurs peuvent aujourd&amp;#x2019;hui &amp;#x00EA;tre expos&amp;#x00E9;s &amp;#x00E0; des poursuites p&amp;#x00E9;nales lorsqu&amp;#x2019;ils d&amp;#x00E9;fendent leurs animaux contre des attaques de loups.&lt;/p&gt;&lt;p style="text-align: justify;"&gt;Cet amendement vise &amp;#x00E0; s&amp;#x00E9;curiser juridiquement leurs actions lorsqu&amp;#x2019;elles sont justifi&amp;#x00E9;es par une situation de l&amp;#x00E9;gitime d&amp;#x00E9;fense.&lt;/p&gt;</exposeSommaire>            
         <annexeExposeSommaire xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:nil="true"/>        
      </contenuAuteur>    
