      <contenuAuteur>            
         <dispositif>&lt;p style="text-align: justify;"&gt;Apr&amp;#x00E8;s l&amp;#x2019;alin&amp;#x00E9;a&amp;nbsp;11, ins&amp;#x00E9;rer les deux alin&amp;#x00E9;as suivants&amp;nbsp;:&amp;nbsp;&lt;/p&gt;&lt;p style="text-align: justify;"&gt;&amp;#x00AB;&amp;nbsp;II&amp;nbsp;&lt;i&gt;bis&lt;/i&gt;.&amp;nbsp;&amp;#x2013;&amp;nbsp;Apr&amp;#x00E8;s l&amp;#x2019;article&amp;nbsp;L.&amp;nbsp;411&amp;#x2011;2&amp;#x2011;2 du code de l&amp;#x2019;environnement, il est ins&amp;#x00E9;r&amp;#x00E9; un article&amp;nbsp;L.&amp;nbsp;411&amp;#x2011;2&amp;#x2011;3 ainsi r&amp;#x00E9;dig&amp;#x00E9;&amp;nbsp;:&lt;/p&gt;&lt;p style="text-align: justify;"&gt;&amp;#x00AB;&amp;nbsp;&lt;i&gt;Art L.&amp;nbsp;411&amp;#x2011;2&amp;#x2011;3&lt;/i&gt;.&amp;nbsp;&amp;#x2013;&amp;nbsp;L&amp;#x2019;&amp;#x00E9;leveur repousse ou d&amp;#x00E9;truit un loup afin de pr&amp;#x00E9;munir son &amp;#x00E9;levage de tout danger, dans le respect des conditions pr&amp;#x00E9;vues aux articles L.&amp;nbsp;411&amp;#x2011;2 et L.&amp;nbsp;411&amp;#x2011;2&amp;#x2011;4.&amp;nbsp;&amp;#x00BB;&amp;nbsp;&amp;#x00BB;&lt;/p&gt;</dispositif>            
         <avantAppel xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:nil="true"/>            
         <exposeSommaire>&lt;p style="text-align: justify;"&gt;Cet amendement affirme le r&amp;#x00F4;le de tout &amp;#x00E9;leveur de prot&amp;#x00E9;ger son troupeau et pour cela de proc&amp;#x00E9;der &amp;#x00E0; la destruction ou &amp;#x00E0; la capture d&amp;#x2019;un loup pr&amp;#x00E9;sentant un danger pour celui-ci dans le respect des conditions pr&amp;#x00E9;vues par les articles L.&amp;nbsp;411&amp;#x2011;1 et L.&amp;nbsp;411&amp;#x2011;2 du code de l&amp;#x2019;environnement.&amp;nbsp;&lt;/p&gt;</exposeSommaire>            
         <annexeExposeSommaire xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:nil="true"/>        
      </contenuAuteur>    
