   <corps>        
      <cartoucheInformatif xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:nil="true"/>        
      <contenuAuteur>            
         <dispositif>&lt;p style="text-align: justify;"&gt;R&amp;#x00E9;diger l&amp;#x2019;alin&amp;#x00E9;a&amp;nbsp;5&amp;nbsp;:&amp;nbsp;&lt;/p&gt;&lt;p style="text-align: justify;"&gt;&amp;#x00AB;&amp;nbsp;Un arr&amp;#x00EA;t&amp;#x00E9; du ministre charg&amp;#x00E9; de l&amp;#x2019;agriculture fixe, chaque ann&amp;#x00E9;e, le nombre de sp&amp;#x00E9;cimens pouvant &amp;#x00EA;tre pr&amp;#x00E9;lev&amp;#x00E9;s &amp;#x00E0; l&amp;#x2019;&amp;#x00E9;chelle nationale. Ce nombre de pr&amp;#x00E9;l&amp;#x00E8;vements peut &amp;#x00EA;tre fix&amp;#x00E9; en tenant compte du nombre minimal de sp&amp;#x00E9;cimens compatible avec un &amp;#x00E9;tat favorable de conservation. Dans ce cas, il correspond &amp;#x00E0; la diff&amp;#x00E9;rence entre la population lupine observ&amp;#x00E9;e et ce nombre minimal de sp&amp;#x00E9;cimens.&amp;nbsp;&amp;#x00BB;&lt;/p&gt;</dispositif>            
         <avantAppel xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:nil="true"/>            
         <exposeSommaire>&lt;p style="text-align: justify;"&gt;Le pr&amp;#x00E9;sent amendement propose de renverser la logique de gestion du loup en France. Actuellement, l&amp;#x2019;autorit&amp;#x00E9; administrative fixe chaque ann&amp;#x00E9;e un pourcentage de la population lupine pouvant &amp;#x00EA;tre pr&amp;#x00E9;lev&amp;#x00E9;e, dans l&amp;#x2019;objectif d&amp;#x2019;assurer la d&amp;#x00E9;fense des &amp;#x00E9;levages. L&amp;#x2019;arr&amp;#x00EA;t&amp;#x00E9; du&amp;nbsp;23&amp;nbsp;f&amp;#x00E9;vrier&amp;nbsp;2026 pr&amp;#x00E9;voit ainsi que 21&amp;nbsp;% de la population (estim&amp;#x00E9;e &amp;#x00E0; 1&amp;nbsp;082 loups) peuvent &amp;#x00EA;tre pr&amp;#x00E9;lev&amp;#x00E9;s cette ann&amp;#x00E9;e (227 loups).&lt;/p&gt;&lt;p style="text-align: justify;"&gt;Or l&amp;#x2019;application d&amp;#x2019;un pourcentage identique plusieurs ann&amp;#x00E9;es de suite, sur une population qui augmente chaque ann&amp;#x00E9;e, conduit m&amp;#x00E9;caniquement &amp;#x00E0; augmenter le nombre de loups pr&amp;#x00E9;sents sur le territoire (c&amp;#x2019;est-&amp;#x00E0;-dire une population lupine qui d&amp;#x00E9;passe le seuil permettant de maintenir le loup en bon &amp;#x00E9;tat de conservation). Par cons&amp;#x00E9;quent, cet amendement ouvre au ministre de l&amp;#x2019;agriculture la possibilit&amp;#x00E9; de d&amp;#x00E9;terminer le pourcentage de loups pouvant &amp;#x00EA;tre pr&amp;#x00E9;lev&amp;#x00E9;s en se fondant sur la diff&amp;#x00E9;rence entre le nombre de loups pr&amp;#x00E9;sents en France, et le nombre minimal de loups &amp;#x00E0; pr&amp;#x00E9;server pour que l&amp;#x2019;esp&amp;#x00E8;ce reste en bon &amp;#x00E9;tat de conservation.&lt;/p&gt;</exposeSommaire>            
         <annexeExposeSommaire xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:nil="true"/>        
      </contenuAuteur>    
