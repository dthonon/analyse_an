   <corps>        
      <cartoucheInformatif>Sous réserve de son traitement par les services de l'Assemblée nationale et de sa recevabilité</cartoucheInformatif>        
      <contenuAuteur>            
         <dispositif>&lt;p&gt;L&amp;#x2019;article&amp;nbsp;L.&amp;nbsp;172&amp;#x2011;1 du code de l&amp;#x2019;environnement est compl&amp;#x00E9;t&amp;#x00E9; par un IV ainsi r&amp;#x00E9;dig&amp;#x00E9;&amp;nbsp;:&lt;/p&gt;&lt;p&gt;&amp;#x00AB;&amp;nbsp;IV.&amp;nbsp;&amp;#x2013;&amp;nbsp;Les armes de service attribu&amp;#x00E9;es aux inspecteurs de l&amp;#x2019;environnement ne&amp;nbsp;sont pas port&amp;#x00E9;es dans le cadre de leurs visites dans&amp;nbsp;les exploitations agricoles.&amp;nbsp;&amp;#x00BB;&lt;/p&gt;</dispositif>            
         <avantAppel xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:nil="true"/>            
         <exposeSommaire>&lt;p&gt;Les armes, souvent port&amp;#x00E9;es de mani&amp;#x00E8;re visible par les agents de l'OFB, permettent difficilement d'instaurer un rapport de confiance avec les agriculteurs.&lt;/p&gt;&lt;p&gt;Afin d'apaiser les tensions, il convient que ces armes ne soient pas port&amp;#x00E9;es en cas de visite dans les exploitations agricoles. La r&amp;#x00E9;daction de cet amendement laissant n&amp;#x00E9;anmoins le port d'arme en ce qui concerne les activit&amp;#x00E9;s de l&amp;#x2019;OFB dans la lutte contre le braconnage.&lt;/p&gt;&lt;p&gt;&amp;nbsp;&lt;/p&gt;</exposeSommaire>            
         <annexeExposeSommaire xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:nil="true"/>        
      </contenuAuteur>    
   </corps>    
