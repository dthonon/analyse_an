      <cartoucheInformatif xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:nil="true"/>        
      <contenuAuteur>            
         <dispositif>&lt;p style="text-align: justify;"&gt;Apr&amp;#x00E8;s l&amp;#x2019;alin&amp;#x00E9;a&amp;nbsp;4, ins&amp;#x00E9;rer l&amp;#x2019;alin&amp;#x00E9;a suivant&amp;nbsp;:&lt;/p&gt;&lt;p style="text-align: justify;"&gt;&amp;#x00AB;&amp;nbsp;Par d&amp;#x00E9;rogation &amp;#x00E0; l&amp;#x2019;alin&amp;#x00E9;a pr&amp;#x00E9;c&amp;#x00E9;dent, l&amp;#x2019;effarouchement et le pr&amp;#x00E9;l&amp;#x00E8;vement des loups aux fins exclusives de la d&amp;#x00E9;fense des troupeaux domestiques r&amp;#x00E9;pondant aux conditions d&amp;#x2019;une d&amp;#x00E9;rogation pr&amp;#x00E9;vue au pr&amp;#x00E9;sent article ne peuvent faire l&amp;#x2019;objet d&amp;#x2019;une interdiction r&amp;#x00E9;glementaire.&amp;nbsp;&amp;#x00BB;&lt;/p&gt;</dispositif>            
         <avantAppel xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:nil="true"/>            
         <exposeSommaire>&lt;p&gt;Cet amendement ainsi que celui portant sur l'article L.332-3 proposent de mettre un terme aux in&amp;#x00E9;galit&amp;#x00E9;s qui existent entre les &amp;#x00E9;leveurs selon le territoire o&amp;#x00F9; p&amp;#x00E2;turent leurs troupeaux. Il l&amp;#x00E8;ve l'interdiction ainsi que la possibilit&amp;#x00E9; d'interdire la capture et la destruction de loups dans les parcs nationaux et les r&amp;#x00E9;serves nationales.&amp;nbsp;&lt;/p&gt;</exposeSommaire>            
         <annexeExposeSommaire xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:nil="true"/>        
      </contenuAuteur>    
   </corps>    
