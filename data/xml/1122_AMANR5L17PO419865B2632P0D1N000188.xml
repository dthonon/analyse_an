      <contenuAuteur>            
         <dispositif>&lt;p style="text-align: justify;"&gt;Compl&amp;#x00E9;ter l&amp;#x2019;alin&amp;#x00E9;a&amp;nbsp;5 par la phrase suivante&amp;nbsp;:&lt;/p&gt;&lt;p style="text-align: justify;"&gt;&amp;#x00AB;&amp;nbsp;Ce nombre peut &amp;#x00EA;tre r&amp;#x00E9;vis&amp;#x00E9; en cas d&amp;#x2019;actualisation des donn&amp;#x00E9;es scientifiques.&amp;nbsp;&amp;#x00BB;&lt;/p&gt;</dispositif>            
         <avantAppel xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:nil="true"/>            
         <exposeSommaire>&lt;p style="text-align: justify;"&gt;Cet amendement du groupe Socialistes et apparent&amp;#x00E9;s&amp;nbsp;vise &amp;#x00E0; pr&amp;#x00E9;ciser que le nombre de loups pouvant &amp;#x00EA;tre d&amp;#x00E9;truits annuellement pourra &amp;#x00EA;tre r&amp;#x00E9;vis&amp;#x00E9; si, en cours d&amp;#x2019;ann&amp;#x00E9;e, des donn&amp;#x00E9;es scientifiques actualis&amp;#x00E9;es le justifient.&lt;/p&gt;</exposeSommaire>            
         <annexeExposeSommaire xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:nil="true"/>        
      </contenuAuteur>    
