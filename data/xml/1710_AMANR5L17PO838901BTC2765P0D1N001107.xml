      <contenuAuteur>            
         <dispositif>&lt;p style="text-align: justify;"&gt;&amp;#x00C0;&amp;nbsp;la fin de l&amp;#x2019;alin&amp;#x00E9;a&amp;nbsp;33, supprimer les mots&amp;nbsp;:&amp;nbsp;&lt;/p&gt;&lt;p style="text-align: justify;"&gt;&amp;#x00AB;&amp;nbsp;,&amp;nbsp;&amp;#x00E0; l&amp;#x2019;exception des c&amp;#x0153;urs de parcs nationaux d&amp;#x00E9;finis &amp;#x00E0; l&amp;#x2019;article&amp;nbsp;L.&amp;nbsp;331&amp;#x2011;2 du m&amp;#x00EA;me code&amp;nbsp;&amp;#x00BB;.&lt;/p&gt;</dispositif>            
         <avantAppel xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:nil="true"/>            
         <exposeSommaire>&lt;p&gt;L&amp;#x2019;amendement adopt&amp;#x00E9; par la Commission d&amp;#x00E9;veloppement durable va dans le bon sens mais reste insuffisant. C&amp;#x2019;est pr&amp;#x00E9;cis&amp;#x00E9;ment dans les zones c&amp;#x0153;urs des parcs nationaux que de nombreux &amp;#x00E9;leveurs se trouvent d&amp;#x00E9;munis pour emp&amp;#x00EA;cher les attaques de loups.&lt;/p&gt;&lt;p&gt;Cet amendement a &amp;#x00E9;t&amp;#x00E9; travaill&amp;#x00E9; avec la FNSEA.&amp;nbsp;&lt;/p&gt;</exposeSommaire>            
         <annexeExposeSommaire xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:nil="true"/>        
      </contenuAuteur>    
