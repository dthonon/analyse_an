         <dispositif>&lt;p style="text-align: justify;"&gt;Apr&amp;#x00E8;s le mot&amp;nbsp;:&lt;/p&gt;&lt;p style="text-align: justify;"&gt;&amp;#x00AB;&amp;nbsp;compte&amp;nbsp;&amp;#x00BB;&lt;/p&gt;&lt;p style="text-align: justify;"&gt;r&amp;#x00E9;diger ainsi la fin de l&amp;#x2019;alin&amp;#x00E9;a&amp;nbsp;5&amp;nbsp;:&lt;/p&gt;&lt;p style="text-align: justify;"&gt;&amp;#x00AB;&amp;nbsp;du seuil de viabilit&amp;#x00E9; de l&amp;#x2019;esp&amp;#x00E8;ce d&amp;#x00E9;finit par le plan national d&amp;#x2019;actions sur le loup en application des articles L.&amp;nbsp;411&amp;#x2011;1, L.&amp;nbsp;411&amp;#x2011;2 et L.&amp;nbsp;411&amp;#x2011;3 du code de l&amp;#x2019;environnement.&amp;nbsp;&amp;#x00BB;&lt;/p&gt;</dispositif>            
         <avantAppel xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:nil="true"/>            
         <exposeSommaire>&lt;p&gt;Le pr&amp;#x00E9;sent amendement vise &amp;#x00E0; inscrire dans la loi la prise en compte du seuil de viabilit&amp;#x00E9; de l&amp;#x2019;esp&amp;#x00E8;ce d&amp;#x00E9;finit par le Plan National d&amp;#x2019;Actions sur le loup (PNA) dans le calcul du nombre de sp&amp;#x00E9;cimens pouvant &amp;#x00EA;tre pr&amp;#x00E9;lev&amp;#x00E9; annuellement&lt;/p&gt;</exposeSommaire>            
